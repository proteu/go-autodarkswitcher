<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.proteu.autodarkmodeswitcher</string>


    <!-- 注入环境变量，让其能找到 Homebrew 安装的命令 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
            <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/Users/linht/bin:/sbin</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>__BIN_PATH__</string>
        <string>-v</string>
        <string>0.75</string>
        <string>-o</string>
        <string>0.045</string>
        <string>-i</string>
        <string>10</string>
        <string>-d</string>
        <string>5</string>
        <string>-l</string>
        <string>info</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG_PATH__/auto-darkmode-switcher.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_PATH__/auto-darkmode-switcher.err</string>
</dict>
</plist>
